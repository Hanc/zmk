#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/*
 * Four-key page turner, in the same order as page_turner.overlay:
 *   1. previous page  2. next page  3. volume up  4. volume down
 *
 * Page Up / Page Down are keyboard HID usages. Volume keys are consumer
 * control usages (C_VOL_UP / C_VOL_DN).
 */

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default";
            bindings = <
                &kp PG_UP
                &kp PG_DN
                &kp C_VOL_UP
                &kp C_VOL_DN
            >;
        };
    };
};
